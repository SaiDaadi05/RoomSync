# --- Required ---
# Postgres connection string
DATABASE_URL="postgresql://roomsync:roomsync@localhost:5432/roomsync"
# Optional: direct (non-pooled) connection used only for migrations during `vercel-build`.
# Neon on Vercel sets this automatically. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=""
# Public base URL of the app (used for invite links, OAuth redirects, email links)
APP_URL="http://localhost:3000"
# 32+ random bytes, base64. Used to encrypt calendar OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Receipts storage ---
# Directory for uploaded receipts (never inside /public). Served only via an authorized route.
STORAGE_DIR="./storage"
# Vercel Blob (private store). When set, receipts go to Blob instead of STORAGE_DIR.
# Required on Vercel (serverless disks are read-only); added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=""

# --- Scheduled reminders on serverless hosts ---
# Protects GET /api/cron/reminders (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
# Not needed if you run `npm run worker` instead. Generate like ENCRYPTION_KEY.
CRON_SECRET=""

# --- Demo mode ---
# "true" shows a clearly labeled "Try the demo" button that creates an isolated demo household.
DEMO_MODE_ENABLED="true"

# --- Email reminders (optional) ---
# If SMTP_HOST is empty, reminders are delivered in-app only and email deliveries are recorded as SKIPPED.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RoomSync <no-reply@example.com>"

# --- Google Calendar (optional) ---
# Create an OAuth client (Web application) in Google Cloud Console, enable the Google Calendar API,
# and add  ${APP_URL}/api/calendar/google/callback  as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
